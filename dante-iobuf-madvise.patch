+#if !SOCKS_CLIENT
+static void
+socks_releasebuffermem(iobuf, which)
+   iobuffer_t *iobuf;
+   const whichbuf_t which;
+{
+   const char *function = "socks_releasebuffermem()";
+   const uintptr_t pagemask = (uintptr_t)sockscf.state.pagesize - 1;
+   const uintptr_t bufstart = (uintptr_t)iobuf->buf[which];
+   uintptr_t start, end, limit;
+
+   if (iobuf->info[which].peaklen == 0)
+      return;
+
+   /*
+    * Only pages lying entirely within buf[which] can be released, as the
+    * partial pages at either end are shared with other data.
+    */
+   start = (bufstart + pagemask) & ~pagemask;
+   limit = (bufstart + sizeof(iobuf->buf[which])) & ~pagemask;
+   end   = MIN((bufstart + iobuf->info[which].peaklen + pagemask) & ~pagemask,
+               limit);
+
+#ifdef MADV_DONTNEED
+   if (end > start) {
+      static int warned;
+      const int errno_s = errno;
+
+      if (madvise((void *)start, (size_t)(end - start), MADV_DONTNEED) != 0) {
+         if (!warned) {
+            swarn("%s: madvise(MADV_DONTNEED) of %lu bytes failed; "
+                  "unused iobuffer memory will not be returned to the kernel "
+                  "(further failures are not logged)",
+                  function, (unsigned long)(end - start));
+            warned = 1;
+         }
+         else
+            slog(LOG_DEBUG, "%s: madvise(MADV_DONTNEED) of %lu bytes failed: %s",
+                 function, (unsigned long)(end - start), strerror(errno));
+      }
+
+      errno = errno_s;
+   }
+#endif /* MADV_DONTNEED */
+
+   iobuf->info[which].peaklen = 0;
 }
+#endif /* !SOCKS_CLIENT */
